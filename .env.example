# Copy to .env.local for local work. In production set the server-only values
# in Vercel (Project Settings, Environment Variables).

# Browser (also in .env.production)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_MEDIA_BASE_URL=https://artu.imtindonesia.com

# Server only: api/*, scripts/
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=imt-website-media
MEDIA_BASE_URL=https://artu.imtindonesia.com
# Service account JSON on one line; lets the panel save the signage greeting
FIREBASE_SERVICE_ACCOUNT=
# Optional: links in AI agent answers (defaults to the request host)
IMT_SITE_URL=

# Local tooling only (migrations, scripts)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
CLOUDFLARE_API_TOKEN=
