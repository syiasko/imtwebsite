{
  "mcpServers": {
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "firebase": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "firebase-tools@latest",
        "mcp",
        "--dir",
        "."
      ],
      "env": {}
    },
    "imt-admin": {
      "type": "stdio",
      "command": "node",
      "args": [
        "mcp/server.mjs"
      ],
      "env": {
        "IMT_ADMIN_USERNAME": "${IMT_ADMIN_USERNAME:-}",
        "IMT_ADMIN_PASSWORD": "${IMT_ADMIN_PASSWORD:-}",
        "IMT_SITE_URL": "${IMT_SITE_URL:-}"
      }
    }
  }
}
