rules_version = '2';

// Firestore now only holds the signage greeting (settings/greeting), read by
// the office TV app. The catalog, accounts and messages moved to Supabase.
// The admin panel writes the greeting through api/greeting.js with the
// Firebase Admin SDK, which bypasses these rules; clients can only read it.
//
// Deploy via: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/greeting {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
